GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

BACKEND_PRODUCTION_DOMAIN=backend.example.com
BACKEND_STAGE_DOMAIN=stage.api.example.com
FRONTEND_PRODUCTION_DOMAIN=frontend.example.com
MONITORING_IP=203.0.113.10
DB_IP=203.0.113.20
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121

VICTORIAMETRICS_RETENTION_MONTHS=1

ALERTMANAGER_EMAIL_FROM=alerts@example.com
ALERTMANAGER_EMAIL_TO=you@example.com
ALERTMANAGER_EMAIL_SMARTHOST=smtp.example.com:587
ALERTMANAGER_EMAIL_AUTH_USERNAME=alerts@example.com
ALERTMANAGER_EMAIL_AUTH_PASSWORD=change-me
ALERTMANAGER_EMAIL_REQUIRE_TLS=true

GLITCHTIP_DOMAIN=https://glitchtip.example.com
GLITCHTIP_SECRET_KEY=change-me-to-a-long-random-value
GLITCHTIP_DEFAULT_FROM_EMAIL=glitchtip@example.com
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_ENABLE_ADMIN=false
GLITCHTIP_ENABLE_OPENAPI=false
GLITCHTIP_ENABLE_MCP=false
GLITCHTIP_ENABLE_DUCKDB=false
GLITCHTIP_POSTGRES_DB=glitchtip
GLITCHTIP_POSTGRES_USER=glitchtip
GLITCHTIP_POSTGRES_PASSWORD=change-me
GLITCHTIP_VALKEY_PASSWORD=change-me

VICTORIAMETRICS_IMAGE=victoriametrics/victoria-metrics:v1.143.0
VMALERT_IMAGE=victoriametrics/vmalert:v1.143.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
GRAFANA_IMAGE=grafana/grafana-oss:11.5.2
GLITCHTIP_IMAGE=glitchtip/glitchtip:6
GLITCHTIP_POSTGRES_IMAGE=postgres:18
GLITCHTIP_VALKEY_IMAGE=valkey/valkey:9
